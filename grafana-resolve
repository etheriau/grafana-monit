#!/usr/bin/env python3

import argparse
import hashlib
import os
import requests
import socket
import sys

#
# CONFIGURATION
# See README for details
#
API_ENDPOINT = "YOUR_API_ENDPOINT"

# Used when API_ENDPOINT is left as is: the GRAFANA_ONCALL_ENDPOINT environment variable, then this file.
ENDPOINT_FILE = "/etc/monit/grafana-oncall.conf"

# Where the open-alert files live; GRAFANA_MONIT_STATE_DIR overrides it. Falls back to /tmp if it cannot be created.
STATE_DIR = "/var/lib/grafana-monit"

# Seconds to wait for Grafana before giving up.
TIMEOUT = 30

#
# END CONFIGURATION
#

# True if you don't want to use files for realerting
DONT_USE_FILES = False

parser = argparse.ArgumentParser( description='Resolves a Grafana OnCall alert' )
parser.add_argument( 'args', metavar='N', nargs='+', help='issue' )
parser.add_argument( '--dontUseFiles', action='store_true', help='Resolve without checking for an open-alert file, as for an alert triggered with --dontUseFiles' )
parser.add_argument( '--force', action='store_true', help='Resolve even when no open-alert file exists, as after a reboot or a rebuilt container lost it' )
args = parser.parse_args()

def endpoint():
    if API_ENDPOINT != "YOUR_API_ENDPOINT":
        return API_ENDPOINT
    if os.environ.get( "GRAFANA_ONCALL_ENDPOINT" ):
        return os.environ["GRAFANA_ONCALL_ENDPOINT"].strip()
    if os.path.isfile( ENDPOINT_FILE ):
        with open( ENDPOINT_FILE ) as f:
            for line in f:
                line = line.strip()
                if line and not line.startswith( "#" ):
                    return line
    return None

def state_dir():
    directory = os.environ.get( "GRAFANA_MONIT_STATE_DIR", STATE_DIR )
    try:
        os.makedirs( directory, exist_ok=True )
        return directory
    except OSError:
        return "/tmp"

def digest( value ):
    try:
        m = hashlib.md5( usedforsecurity=False )
    except TypeError:
        m = hashlib.md5()
    m.update( value.encode( 'utf-8' ) )
    return m.hexdigest()

url = endpoint()
if url is None:
    print( "Must specify API_ENDPOINT, GRAFANA_ONCALL_ENDPOINT or %s!" % ENDPOINT_FILE )
    sys.exit( 1 )

EVENT=args.args[0]
HOST=socket.gethostname()
if args.dontUseFiles:
    DONT_USE_FILES=args.dontUseFiles

name = "grafana-" + digest( HOST + ":" + EVENT )
# Earlier versions kept the file in /tmp; an alert opened before an upgrade is still found there.
files = [f for f in { os.path.join( state_dir(), name ), os.path.join( "/tmp", name ) } if os.path.isfile( f )]
if not DONT_USE_FILES and not args.force and not files:
    print("%s does not exist" % os.path.join( state_dir(), name ))
    sys.exit( 1 )

try:
    data = {
        'message': EVENT + " failed on " + HOST,
        'entity': HOST,
        'state': 'OK'
    }

    body = requests.post( url, json=data, timeout=TIMEOUT )
    body.raise_for_status()

    print('body: {}'.format( body ))

    for f in files:
        os.remove( f )
except Exception as err:
    print("Exception when calling URL: %s\n" % err)
    sys.exit( 1 )
